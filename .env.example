# Testnet-only key that deploys and owns the contracts. Never use a key that holds real funds.
DEPLOYER_KEY=

# The wallet being protected, and the address rescued tokens are sent to.
WALLET=
SAFE=

BASE_SEPOLIA_RPC=https://sepolia.base.org
UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org

# true = outgoing transfers to unknown recipients also trip the wire.
WATCH_TRANSFERS=true

# Filled in by script/deploy.sh
REACTIVE=
RESCUER_BASE=
RESCUER_UNI=

# Only for the demo scripts (setup-demo.sh / attack.sh): testnet keys and addresses.
DEPLOYER=
WALLET_KEY=
DRAINER=
